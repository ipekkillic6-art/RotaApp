{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    // node --test kaynak dosyaları doğrudan çalıştırıyor ve ESM uzantısız
    // import'u çözemiyor. Test edilen modüller birbirini `./x.ts` diye import
    // eder; Metro açık uzantıyı zaten çözüyor, tsc de bununla izin veriyor.
    "allowImportingTsExtensions": true,
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "exclude": ["**/*.test.ts", "**/*.test.tsx"]
}
